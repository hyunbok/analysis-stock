{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Request Duration by Exchange",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(cointrader_exchange_request_duration_seconds_bucket[5m])) by (exchange, le))",
          "legendFormat": "{{ exchange }} p95"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(cointrader_exchange_request_duration_seconds_bucket[5m])) by (exchange, le))",
          "legendFormat": "{{ exchange }} p50"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "Error Rate by Exchange",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(cointrader_exchange_request_errors_total[5m])) by (exchange, error_type)",
          "legendFormat": "{{ exchange }}: {{ error_type }}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "title": "Circuit Breaker State",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "cointrader_circuit_breaker_state",
          "legendFormat": "{{ exchange }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 2,
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CLOSED" }, "1": { "text": "HALF-OPEN" }, "2": { "text": "OPEN" } } }
          ]
        }
      }
    },
    {
      "title": "Request Volume by Method",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(cointrader_exchange_request_duration_seconds_count[5m])) by (exchange, method)",
          "legendFormat": "{{ exchange }}: {{ method }}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["cointrader", "exchange"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "CoinTrader - Exchange Health",
  "uid": "cointrader-exchange-health"
}
